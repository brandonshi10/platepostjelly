# Next.js / Vercel
# Use a PlatePost development deployment locally. Never copy production secrets here.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# Public browser map token
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# PlatePost server authentication
# Generate independent, long random values. Set PLATEPOST_CONVEX_SERVICE_KEY
# to the same value in Vercel and the matching Convex deployment.
PLATEPOST_CONVEX_SERVICE_KEY=
JELLYHUNT_API_KEY=

# Local UI development only. Use "fixture" locally or "convex" for real data.
# Fixture mode is disabled automatically in production.
JELLYHUNT_DATA_SOURCE=convex

# PlatePost admin login and signed HTTP-only session
JELLYHUNT_ADMIN_USERNAME=
JELLYHUNT_ADMIN_PASSWORD=
JELLYHUNT_ADMIN_SESSION_SECRET=

# Optional public app-store overrides
NEXT_PUBLIC_JELLY_IOS_APP_URL=https://apps.apple.com/us/app/jellyjelly-human-social/id6505022038
NEXT_PUBLIC_JELLY_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=app.jellyjelly.prod

# Convex environment variables
# Add these in the Convex dashboard; do not expose them to browser code.
JELLY_API_BASE_URL=https://api.jellyjelly.com
JELLYHUNT_MAX_REWARD_AMOUNT=10000

# Preferred production partner integration
# Credential-bearing non-loopback endpoints must use HTTPS.
JELLY_PARTNER_VERIFY_URL=
JELLY_PARTNER_REWARD_URL=
JELLY_PARTNER_API_KEY=

# Migration-only legacy integration
JELLY_LEGACY_API_TOKEN=
JELLY_REWARD_API_TOKEN=
JELLY_REWARD_AUTH_SCHEME=Token
# Backward-compatible fallback only; prefer JELLY_REWARD_API_TOKEN.
JELLY_REWARD_BEARER_TOKEN=
